          }
        },
        "required": [
          "identifier"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "record": {
            "type": "object",
            "properties": {
              "lei": {
                "type": "object",
                "properties": {
                  "value": {},
                  "source_url": {
                    "type": "string"
                  },
                  "read_by": {
                    "type": "string"
                  },
                  "read": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "sourced",
                      "filled",
                      "confirmed",
                      "conflict",
                      "unverified"
                    ]
                  }
                },
                "required": [
                  "value",
                  "source_url",
                  "read_by",
                  "state"
                ]
              },
              "identity": {
                "type": "object"
              },
              "registrations": {
                "type": "array"
              },
              "principals": {
                "type": "array"
              },
              "aliases": {
                "type": "array"
              },
              "events": {
                "type": "array"
              },
              "gaps": {
                "type": "array"
              }
            }
          }
        },
        "required": [
          "record"
        ]
      }
    },
