    },
    {
      "url": "https://es.fo-kg.ai",
      "description": "node door es-fo-kg"
    },
    {
      "url": "https://fr.fo-kg.ai",
      "description": "node door fr-fo-kg"
    },
    {
      "url": "https://it.fo-kg.ai",
      "description": "node door it-fo-kg"
