    {
      "url": "https://mcp.fo-kg.ai",
      "description": "apex door"
    },
    {
      "url": "https://ae.fo-kg.ai",
      "description": "node door ae-fo-kg"
    },
    {
      "url": "https://au.fo-kg.ai",
      "description": "node door au-fo-kg"
    },
    {
