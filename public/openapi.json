    "version": "0.19.10",
    "description": "Family Office Knowledge Graph. Operator: Agentic KG Holdings. Public record, read-only; MCP doors (apex + node); one paid call (x402); one licensed route (office OAuth).",
    "contact": {
      "name": "Agentic KG Holdings",
      "email": "mk@agent-kg.ai",
      "url": "https://familyofficeknowledgegraph.ai/#contact"
    }
  },
